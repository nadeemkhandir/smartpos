# SmartPOS configuration.
#
# Copy this file to ".env" in the project root and fill in the values you need.
# Real environment variables win over anything set here, and every setting has a
# working default, so the application runs with no .env file at all.
#
# Keep the real .env out of version control: it holds a mail password.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Defaults to app/db/smartpos.db
# SMARTPOS_DB=C:\SmartPOS\data\smartpos.db

ORGANISATION=SmartPOS

# ------------------------------------------------------------------
# E-mail (used to send password-reset codes)
# ------------------------------------------------------------------
# Leave SMTP_HOST blank and reset codes are written to logs/sent_emails.log
# instead of being sent — useful while developing, useless in a real shop.
#
# GMAIL: SMTP_PASSWORD must be an APP PASSWORD - 16 letters, nothing else.
# Your normal Google account password will NOT work; Google stopped accepting
# those over SMTP in 2022 and answers with:
#
#     535 5.7.8 Username and Password not accepted ... BadCredentials
#
#   1. Switch on 2-step verification: https://myaccount.google.com/security
#   2. Create an app password:        https://myaccount.google.com/apppasswords
#   3. Google shows it as "abcd efgh ijkl mnop" - paste it here, with or
#      without the spaces (they are stripped for you).
#
# Then check it before trying the app:  python -m tools.check_email you@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_NAME=SmartPOS
SMTP_FROM_ADDRESS=your.address@gmail.com
SMTP_TIMEOUT=20

# ------------------------------------------------------------------
# SMS (approval, rejection and password-change notices)
# ------------------------------------------------------------------
# SmartPOS sends no one-time codes. These are courtesy notices: "your account
# was approved", "your password was just changed". Leave TWILIO_ACCOUNT_SID
# blank and they are written to logs/sent_sms.log instead of being sent.
#
# Twilio: create an account at https://console.twilio.com, take the Account SID
# and Auth Token from the dashboard, and buy (or use the trial) number as
# TWILIO_FROM_NUMBER. A trial account can ONLY text numbers you have verified
# in the console, so upgrade before staff rely on it.
#
# Check it with:  python -m tools.check_sms --send 0300 1234821

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TIMEOUT=20

# Prefixed to every message so a handset shows who is asking.
SMS_SENDER_NAME=SmartPOS

# Assumed for any mobile number typed without a country code. +92 is Pakistan;
# change it to wherever the shop is. Staff can always type a full +... number.
SMS_DEFAULT_COUNTRY_CODE=+92

# ------------------------------------------------------------------
# Self-service registration
# ------------------------------------------------------------------
# When on, the sign-in screen offers "Create one". Filling the form in creates
# the account immediately, but switched off and pending: nobody can sign in
# until somebody with the approve-registrations permission lets them in and
# picks their role. Approval is the only gate, so leave it off on a terminal
# where only an administrator should add staff.

REGISTRATION_ENABLED=true

# Role offered first when approving. The approver can always choose another.
REGISTRATION_DEFAULT_ROLE=cashier

# ------------------------------------------------------------------
# First-run administrator
# ------------------------------------------------------------------
# Created only when the users table is empty. The account is flagged so the
# password must be changed at the first sign-in.

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@smartpos.local
SEED_ADMIN_PASSWORD=Admin@123

# ------------------------------------------------------------------
# Security policy
# ------------------------------------------------------------------
PBKDF2_ITERATIONS=240000
MIN_PASSWORD_LENGTH=8

# Sign-in lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=10

# "Remember me" lifetime, in days
REMEMBER_ME_DAYS=30

# Say "no such account" on the reset screen (helpful for staff on an internal
# till). Set to false and an unknown name is accepted and then quietly refused,
# so the screen cannot be used to discover which accounts exist.
REVEAL_UNKNOWN_ACCOUNT=true
